#!/usr/bin/env bash
set -euo pipefail

# A host service supplies a prebuilt runner and its own state directory.
state_root=${HACKATHON_VM_STATE:-${XDG_STATE_HOME:-${HOME}/.local/state}/efficient-local-agents/vm}
runner=${HACKATHON_VM_RUNNER:-}
variant=vm-with-bob
tcg=false
memory=
cpus=
usage() {
  printf '%s\n' 'Usage: scripts/vm-run [--no-bob] [--memory MiB] [--cpus N] [--tcg]' \
    '  --no-bob      Start the variant without the unfree IBM Bob Shell package' \
    '  --memory MiB  Guest RAM (default 8192)' \
    '  --cpus N      Guest vCPUs (default 4)' \
    '  --tcg         Slow software emulation when KVM is unavailable' \
    "State: $state_root" \
    'The guest console opens in this terminal. The guest runs no SSH daemon and' \
    'no port is forwarded. Leave with: sudo poweroff'
}
number() {
  [[ "${2:-}" =~ ^[1-9][0-9]*$ ]] || { printf '%s needs a positive integer.\n' "$1" >&2; exit 2; }
}
while (($#)); do
  case "$1" in
    --bob) variant=vm-with-bob ;;
    --no-bob) variant=vm ;;
    --tcg) tcg=true ;;
    --memory) number "$1" "${2:-}"; memory=$2; shift ;;
    --cpus) number "$1" "${2:-}"; cpus=$2; shift ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done
if [[ -z "$runner" ]]; then
  command -v nix >/dev/null || { printf '%s\n' 'Install Nix with flakes before starting the VM.' >&2; exit 1; }
fi
umask 077
mkdir -p -- "$state_root"
chmod 700 -- "$state_root"
command -v flock >/dev/null || { printf '%s\n' 'flock is required; enter nix develop or install util-linux.' >&2; exit 1; }
exec 9>"$state_root/runner.lock"
flock -n 9 || { printf '%s\n' 'This VM disk already has an active runner.' >&2; exit 1; }
if [[ ! -c /dev/kvm || ! -r /dev/kvm || ! -w /dev/kvm ]]; then
  printf '%s\n' 'KVM is unavailable. Use the devShell inside your existing Lab VM, or pass --tcg for slow software emulation.' >&2
  if ! "$tcg"; then exit 1; fi
fi

options=${QEMU_OPTS:-}
# The generated runner writes a multi-gigabyte Nix store image into its working
# directory at every start. One reused directory beside the disk avoids filling
# a RAM-backed /tmp and leaving an image behind per boot.
run_dir=$state_root/run
mkdir -p -- "$run_dir"
# The generated runner places QEMU_OPTS after its own -m/-smp, so these win.
if [[ -n "$memory" ]]; then options+=" -m $memory"; fi
if [[ -n "$cpus" ]]; then options+=" -smp $cpus"; fi
if "$tcg"; then options+=" -accel tcg -cpu max"; fi

if [[ -z "$runner" ]]; then
  repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
  runner=$(nix build --no-link --print-out-paths "${repo}#${variant}")
fi
export NIX_DISK_IMAGE="$state_root/hackathon.qcow2"
export QEMU_OPTS=$options TMPDIR=$run_dir USE_TMPDIR=1
exec "$runner/bin/run-hackathon-vm"
