#!/usr/bin/env bash
# The gate before every commit: format, lint and the offline tests. Needs uv
# and nothing else; it sends no request.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
uv sync --locked
bash scripts/ruff format --check src tests examples
bash scripts/ruff check src tests examples
# As a module: a virtual environment whose folder was moved keeps stale script paths.
uv run --locked python -m pytest -q
