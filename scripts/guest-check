#!/usr/bin/env bash
# Runs inside the guest, from the seeded project. scripts/vm-smoke starts it
# over the console; it is also a quick self-test after changing the guest.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

echo "python: $(python3 --version), fallback: $(python3.14 --version), uv: $(uv --version)"
echo "resources: $(nproc) vCPUs, $(awk '/MemTotal/ {printf "%d MiB", $2/1024}' /proc/meminfo)"
if command -v bob >/dev/null; then echo "bob: $(bob --version 2>&1 | tail -n 1)"; else echo "bob: not in this variant"; fi

# No remote login: neither an SSH daemon nor any listener beyond loopback.
if systemctl is-active --quiet sshd.service 2>/dev/null; then
  echo 'An SSH daemon is running in the guest.' >&2
  exit 1
fi
listeners=$(ss -H -ltnu | awk '$5 !~ /^(127\.|\[::1\]|\[fe80:)/ && $5 !~ /:68$/' || true)
if [[ -n "$listeners" ]]; then
  printf 'Unexpected network listeners:\n%s\n' "$listeners" >&2
  exit 1
fi
echo "remote login: no SSH daemon, no network listener"

# The host's loopback services must stay out of the guest's reach. QEMU user
# networking would map them to 10.0.2.2; the guest firewall rejects that. The
# smoke test names a port on which the host certainly listens.
if [[ -n "${HOST_PROBE_PORT:-}" ]]; then
  if timeout 3 bash -c "</dev/tcp/10.0.2.2/$HOST_PROBE_PORT" 2>/dev/null; then
    echo 'The guest reached a host loopback service.' >&2
    exit 1
  fi
  echo "host loopback: unreachable from the guest"
fi

wormhole --version >/dev/null
git remote get-url origin
test -r .bob/skills/typesafe-ai/SKILL.md || test -r .agents/skills/typesafe-ai/SKILL.md
echo "skills: $(find .bob/skills .agents/skills -mindepth 1 -maxdepth 1 2>/dev/null | wc -l) linked"
just ready >/dev/null
just dev-status >/dev/null
test -r .bob/mcp.json
echo "development memory, code index and MCP configuration: ready"
just check
just benchmark >/dev/null
just dev-down >/dev/null
# Binary wheels that need libstdc++ and zlib from the guest.
uv run --locked --with numpy --with pandas --with pymupdf --with duckdb \
  python -c 'import numpy, pandas, pymupdf, duckdb; print("native wheels: ok")'
