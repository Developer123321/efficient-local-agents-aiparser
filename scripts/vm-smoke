#!/usr/bin/env bash
# Boots the VM on a disposable disk and checks the guest end to end by driving
# its console, the only way into the guest. Needs KVM, PyPI and the container
# image registries; SKIP_CONTAINER_TEST=1 leaves the image build out and
# PORTABILITY_TEST=1 adds the laptop setup inside stock distribution images.
set -euo pipefail

repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
work=$(mktemp -d "${TMPDIR:-/tmp}/hackathon-vm-smoke.XXXXXX")
qemu=
cleanup() {
  exec 3>&- 2>/dev/null || true
  if [[ -n "$qemu" ]]; then kill "$qemu" 2>/dev/null || true; wait "$qemu" 2>/dev/null || true; fi
  rm -rf -- "$work"
}
trap cleanup EXIT
log=$work/console.log
mkfifo "$work/keys"
# For this test only, QEMU listens on one host loopback port. The guest must
# fail to reach it through the host's address in QEMU's user network.
probe=$((20000 + RANDOM))
XDG_STATE_HOME=$work/state QEMU_NET_OPTS="hostfwd=tcp:127.0.0.1:$probe-:9" \
  bash "$repo/scripts/vm-run" "$@" --memory 6144 --cpus 3 \
  <"$work/keys" >"$log" 2>&1 &
qemu=$!
exec 3>"$work/keys"
# Waits until the console log shows a pattern, or fails with the log's tail.
expect() {
  local pattern=$1 seconds=$2
  for _ in $(seq "$seconds"); do
    if grep -aEq -- "$pattern" "$log"; then return 0; fi
    if ! kill -0 "$qemu" 2>/dev/null; then break; fi
    sleep 1
  done
  tr -d '\r' <"$log" | tail -n 30 >&2
  printf 'The guest console never showed: %s\n' "$pattern" >&2
  return 1
}
expect 'hackathon@hackathon:[^ ]*\]\$' 300
# One short line: the checks themselves are part of the seeded project.
printf '%s\n' "echo SMOKE_BEGIN; HOST_PROBE_PORT=$probe SKIP_CONTAINER_TEST=${SKIP_CONTAINER_TEST:-} PORTABILITY_TEST=${PORTABILITY_TEST:-} bash ~/workspace/hacklab-vm/scripts/guest-check; echo \"SMOKE_EXIT=\$?\"" >&3
# Includes three dependency syncs, the container image build and, on request,
# the portability test.
expect 'SMOKE_EXIT=[0-9]+' 2700
# Drop terminal control sequences, then show what the guest printed.
tr -d '\r' <"$log" | sed -E 's/\x1b\][^\x07\x1b]*(\x07|\x1b\\)//g; s/\x1b\[[0-9;?]*[A-Za-z]//g' |
  sed -n '/SMOKE_BEGIN$/,/SMOKE_EXIT=[0-9]/p' | sed '1d'
grep -aq 'SMOKE_EXIT=0' "$log" || { printf '%s\n' 'Guest checks failed.' >&2; exit 1; }
printf '%s\n' 'VM smoke test passed.'
