#!/usr/bin/env bash
set -euo pipefail

repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
port=${HACKATHON_VM_SSH_PORT:-2222}
if [[ ! "$port" =~ ^[0-9]+$ ]] || ((port < 1 || port > 65535)); then
  printf '%s\n' 'HACKATHON_VM_SSH_PORT must be 1..65535.' >&2
  exit 2
fi
cd -- "$repo"
if ! git ls-files --error-unmatch pyproject.toml uv.lock >/dev/null 2>&1; then
  printf '%s\n' 'Tracked pyproject.toml and uv.lock are required. Review and stage the project source first.' >&2
  exit 1
fi
# Only versioned source is copied; ignored credentials, datasets and traces stay local.
# SSH retains normal host-key verification. Add your public key via the VM console first.
git ls-files -z | tar --null --no-recursion -T - -cf - |
  ssh -p "$port" hackathon@127.0.0.1 \
    'umask 077; mkdir -p "$HOME/workspace/python-vm"; tar -xf - -C "$HOME/workspace/python-vm"'
printf '%s\n' 'Source copied. In the VM: cd ~/workspace/python-vm && uv sync --frozen && just doctor'
