#!/usr/bin/env bash
# Builds the agent image and proves it works the way the evaluation runs it:
# without any network. A stand-in model shares the agent's network namespace,
# which has a loopback interface and nothing else. Needs Docker or Podman and,
# for the build only, access to the image registries and PyPI.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
# Git Bash on Windows rewrites arguments that look like Unix paths; the paths
# below are paths inside the container.
export MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*'

engine=${CONTAINER_ENGINE:-}
if [[ -z "$engine" ]]; then
  engine=$(command -v docker || command -v podman || true)
fi
[[ -n "$engine" ]] || { echo 'Install Docker or Podman, or set CONTAINER_ENGINE.' >&2; exit 1; }
"$engine" info >/dev/null 2>&1 || {
  echo "$engine is installed but does not answer: start Docker Desktop or the daemon," >&2
  echo 'or on Linux add yourself to the docker group and log in again.' >&2
  exit 1
}
image=${HACKLAB_IMAGE:-hacklab-agent:test}
# Set HACKLAB_PLATFORM=linux/amd64 to build on an ARM laptop for an x86_64 evaluation.
platform=${HACKLAB_PLATFORM:-}
model=hacklab-model-$$
volume=hacklab-work-$$
cleanup() {
  "$engine" rm -f "$model" >/dev/null 2>&1 || true
  "$engine" volume rm -f "$volume" >/dev/null 2>&1 || true
}
trap cleanup EXIT

"$engine" build ${platform:+--platform "$platform"} -t "$image" .
"$engine" volume create "$volume" >/dev/null
offline=(${platform:+--platform "$platform"} --rm --network none -v "$volume:/work")
# Runs a shell script inside the image; the remaining arguments go to `run`.
inside() {
  local script=$1
  shift
  "$engine" run "$@" --entrypoint sh "$image" -c "$script"
}

# 1. Offline and without a model: generate a rehearsal incident, solve it by code.
"$engine" run "${offline[@]}" "$image" practice --seed 1 --out /work/scenario --agents 20 --events 300 >/dev/null
"$engine" run "${offline[@]}" "$image" benchmark --config configs/practice.toml \
  --dataset /work/scenario/cases.jsonl --root /work/scenario/docs --out /work/report.json |
  tee /dev/stderr | grep -q '"accuracy": 1.0'
echo 'offline playbooks: 9 of 9 rehearsal tasks, no model call'

# 2. The model path: a stand-in endpoint on the shared loopback interface. The
# candidate profile must find its solvers and recipes inside the image.
"$engine" run "${offline[@]}" "$image" doctor --strict --config configs/live.toml >/dev/null
# Starts the stand-in afresh: it forgets the run it served before.
serve() {
  "$engine" rm -f "$model" >/dev/null 2>&1 || true
  "$engine" run -d ${platform:+--platform "$platform"} --name "$model" --network none \
    "$image" mock-server --port 8080 >/dev/null
}
serve
shared=(${platform:+--platform "$platform"} --rm --network "container:$model" -v "$volume:/work")
endpoints=(-e SMALL_MODEL_BASE_URL=http://127.0.0.1:8080/v1 -e SMALL_MODEL_NAME=mock-small
  -e SMALL_MODEL_API_KEY=synthetic)
# Nine lines, every one an abstention: the stand-in model never answers.
# shellcheck disable=SC2016  # expanded by the shell inside the container
nine_abstentions='test "$(wc -l < "$1")" -eq 9 && ! grep -v "\"status\": \"abstain\"" "$1"'
answered() {
  "$engine" run "${offline[@]}" --entrypoint sh "$image" -c "$nine_abstentions" check "$1"
}
for profile in baseline live; do
  "$engine" run "${shared[@]}" "${endpoints[@]}" "$image" submit --config "configs/$profile.toml" \
    --input /work/scenario/tasks.jsonl --output "/work/answers-$profile.jsonl" \
    --root /work/scenario/docs --workers 3 >/dev/null
  answered "/work/answers-$profile.jsonl"
done
echo 'model path: 9 answers each for the baseline and the candidate profile'

# 3. Jev. If the organizers route it into the container, both models answer
# over a local address; if they do not, the agent still answers every task.
report=$("$engine" run "${shared[@]}" "${endpoints[@]}" \
  -e TYPESAFE_BASE_URL=http://127.0.0.1:8080/v1/systemone -e TYPESAFE_API_KEY=synthetic \
  "$image" probe --config configs/jev-select.toml)
grep -q '"provider": "jev"' <<<"$report"
"$engine" run "${shared[@]}" "${endpoints[@]}" "$image" submit --config configs/jev-select.toml \
  --input /work/scenario/tasks.jsonl --output /work/answers-without-jev.jsonl \
  --root /work/scenario/docs >/dev/null
answered /work/answers-without-jev.jsonl
echo 'jev: reachable through a local route; without one, 9 answers and no error'

# 3b. The embedding model, under the same two conditions: named and reachable
# next to the small model, or not announced to the container at all.
report=$("$engine" run "${shared[@]}" "${endpoints[@]}" -e EMBEDDING_MODEL_NAME=mock-embedding \
  "$image" probe --config configs/embed-rank.toml)
grep -q '"provider": "embedding"' <<<"$report"
"$engine" run "${shared[@]}" "${endpoints[@]}" -e EMBEDDING_MODEL_NAME=mock-embedding \
  "$image" submit --config configs/embed-rank.toml --input /work/scenario/tasks.jsonl \
  --output /work/answers-embedding.jsonl --root /work/scenario/docs >/dev/null
answered /work/answers-embedding.jsonl
"$engine" run "${shared[@]}" "${endpoints[@]}" "$image" submit --config configs/embed-rank.toml \
  --input /work/scenario/tasks.jsonl --output /work/answers-without-embedding.jsonl \
  --root /work/scenario/docs >/dev/null
answered /work/answers-without-embedding.jsonl
echo 'embedding: reachable through a local route; without a model name, 9 answers and no error'

# 3c. The event's run contract: started without a command and with nothing but
# the organizers' five variables, the container starts a run on the Task API,
# mirrors the workspaces, submits every task and finishes the run.
summary=$("$engine" run "${shared[@]}" -e ARENA_BASE_URL=http://127.0.0.1:8080 \
  -e ARENA_API_KEY=arena_synthetic -e OPENROUTER_BASE_URL=http://127.0.0.1:8080/v1 \
  -e OPENROUTER_API_KEY=synthetic -e ARENA_RUN_KIND=dev "$image")
grep -q '"tasks_submitted": 2' <<<"$summary"
# Every answer arrived. The stand-in tasks are none a solver knows, and the
# candidate profile then asks no model: nothing was spent.
grep -q '"submit_errors": \[\]' <<<"$summary"
grep -q '"local_calls": 0' <<<"$summary"
# With the model loop switched on for one run, each request's reported cost
# reaches our own tally. A fresh stand-in and a state directory of its own:
# the run before left nothing to do on either side.
serve
summary=$("$engine" run "${shared[@]}" -e ARENA_BASE_URL=http://127.0.0.1:8080 \
  -e ARENA_API_KEY=arena_synthetic -e OPENROUTER_BASE_URL=http://127.0.0.1:8080/v1 \
  -e OPENROUTER_API_KEY=synthetic -e ARENA_RUN_KIND=dev -e HACKLAB_FALLBACK=loop \
  -e HACKLAB_ARENA_DIR=/work/arena-loop "$image")
grep -q '"tasks_submitted": 2' <<<"$summary"
grep -q '"submit_errors": \[\]' <<<"$summary"
grep -Eq '"local_reported_cost_calls": [1-9]' <<<"$summary"
grep -q '"local_unknown_spend_calls": 0' <<<"$summary"
# Options alone are options of that run, as in the organizers' local test.
"$engine" run "${shared[@]}" -e ARENA_BASE_URL=http://127.0.0.1:8080 \
  -e ARENA_API_KEY=arena_synthetic -e OPENROUTER_BASE_URL=http://127.0.0.1:8080/v1 \
  -e OPENROUTER_API_KEY=synthetic "$image" --tasks t01 --no-finish | grep -q '"tasks": 0'
echo 'arena: a run of two tasks submitted and finished through a local gateway address'

# 3d. The opt-in image tool: the profile that lists it shows the model a
# picture through the same gateway address and key.
report=$("$engine" run "${shared[@]}" -e OPENROUTER_BASE_URL=http://127.0.0.1:8080/v1 \
  -e OPENROUTER_API_KEY=synthetic "$image" probe --config configs/image-read.toml)
grep -q 'no model looked at the picture' <<<"$report"
echo 'image: a picture reaches the model endpoint through the local gateway address'

# 4. The agent's network namespace must not reach the internet.
probe='python -c "import socket; socket.create_connection((\"1.1.1.1\", 443), 3)" 2>/dev/null'
if inside "$probe" "${shared[@]}"; then
  echo 'The agent container reached the internet.' >&2
  exit 1
fi
echo 'egress: unreachable from the agent container'

# 5. The agent runs unprivileged and cannot change its own code.
# shellcheck disable=SC2016
inside 'test "$(id -u)" -eq 10001 && ! touch /app/x 2>/dev/null' "${offline[@]}"
echo "image: $("$engine" image inspect --format '{{.Size}}' "$image" | awk '{printf "%d MiB", $1/1048576}'), runs as uid 10001"
echo 'Container test passed.'
