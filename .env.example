# Runtime only. Never paste keys into TOML, Nix, source, prompts or benchmark fixtures.
# The small model is Gemma 4 31B. Use the name the organizers hand out; it is
# google/gemma-4-31B-it on Hugging Face and vLLM, google/gemma-4-31b-it on
# OpenRouter.
SMALL_MODEL_API_KEY=
SMALL_MODEL_BASE_URL=
SMALL_MODEL_NAME=
TYPESAFE_API_KEY=
# Qwen3 Embedding, only used with [embedding] enabled = true. The name depends
# on the size the organizers serve, for example Qwen/Qwen3-Embedding-0.6B.
# Without an address and a key of its own it uses the small model's.
# EMBEDDING_MODEL_NAME=
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# Alternatively use SMALL_MODEL_API_KEY_FILE / TYPESAFE_API_KEY_FILE.
# Only if the organizers route Jev through their own gateway:
# TYPESAFE_BASE_URL=
# While iterating, replay unchanged requests instead of paying for them again:
# HACKLAB_CACHE_MODE=readwrite
