# Runtime only. Never paste keys into TOML, Nix, source, prompts or benchmark fixtures.
#
# The event (dashboard at https://arena.ai-mission.eu): two keys are enough.
# ARENA_API_KEY is the team's platform key (arena_...), OPENROUTER_API_KEY the
# dev key for the three models. With OPENROUTER_API_KEY set, every model of
# every profile is asked at OpenRouter under the event's names and the
# SMALL_MODEL_* / TYPESAFE_* / EMBEDDING_* lines below are not used.
ARENA_API_KEY=
OPENROUTER_API_KEY=
# ARENA_BASE_URL=https://arena.ai-mission.eu
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# ARENA_MAIN_MODEL=google/gemma-4-31b-it
# Tools that change something (containment, send_message, write) are offered
# only when the instruction asks to act: auto (default), always, never.
# HACKLAB_ARENA_ACTIONS=auto
#
# Outside the event: any OpenAI-compatible endpoint for the small model.
# Gemma 4 31B is google/gemma-4-31B-it on Hugging Face and vLLM.
SMALL_MODEL_API_KEY=
SMALL_MODEL_BASE_URL=
SMALL_MODEL_NAME=
TYPESAFE_API_KEY=
# Qwen3 Embedding, only used with [embedding] enabled = true, for example
# Qwen/Qwen3-Embedding-0.6B. Without an address and a key of its own it uses
# the small model's.
# EMBEDDING_MODEL_NAME=
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# Alternatively use SMALL_MODEL_API_KEY_FILE / TYPESAFE_API_KEY_FILE.
# TypeSafe's API behind another address:
# TYPESAFE_BASE_URL=
# While iterating, replay unchanged requests instead of paying for them again:
# HACKLAB_CACHE_MODE=readwrite
